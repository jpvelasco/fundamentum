#!/usr/bin/env bash
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/lib.sh"

# Fail-fast: live Codecov workflow vs embed template functional parity
# (OIDC, use_pypi, coverage flags, SHA pin). Action SHAs may differ.
echo "→ template drift"
go test ./internal/templatefs/ -run TestCodecovTemplateDrift -count=1
echo "→ build"
go build ./...
echo "→ lint"
# Test if golangci-lint is both available and executable (AppLocker may block it)
if command -v golangci-lint &>/dev/null && golangci-lint version &>/dev/null; then
    golangci-lint run ./...
else
    echo "    golangci-lint not found or not executable, falling back to go vet"
    go vet ./...
fi
echo "→ test"
setup_go_tmpdir
go test ./...
