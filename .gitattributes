# Ensure consistent line endings for Go source files across platforms.
# Windows checkouts with core.autocrlf=true convert LF to CRLF, which
# causes gofmt failures in CI. Force LF for all Go files.
.gitattributes text eol=lf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# POSIX scripts must retain LF in Windows worktrees so local ShellCheck results
# match Codacy and Linux CI. Hooks are extensionless shell scripts.
*.sh text eol=lf
.hooks/* text eol=lf

# Workflow YAML must retain LF in Windows worktrees: the templatefs parity
# tests compare live workflows line-for-line against the embed template, and a
# mixed CRLF/LF pair would fail locally.
.github/workflows/*.yml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# npm shim JS must retain LF in Windows worktrees so CI checksums and the
# published package stay byte-identical across platforms.
*.js text eol=lf
